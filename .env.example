# Copy to .env.local and fill in. Never commit .env.local.
# Each feature adds the variable names it needs here (names only, no values).

# Gemini API key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional: the model for the thorough (Teliti) mode, e.g. a stronger Gemini model once billing is on. Empty: gemini-flash-latest.
GEMINI_MODEL=

# Python with Scrapling for reading pages (pip install "scrapling[fetchers]"), e.g. /opt/cekkerja/venv/bin/python. Empty: the built-in fetcher is used.
SCRAPLING_PYTHON=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Midtrans Snap (sandbox by default): https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
