# Copy to .env.local and fill in. Never commit .env.local.
# Each feature adds the variable names it needs here (names only, no values).

# Gemini API key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# AI provider: gemini (default) or claude. Claude needs an Anthropic API key: https://console.anthropic.com
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=

# Python with Scrapling for reading pages (pip install "scrapling[fetchers]"), e.g. /opt/cekkerja/venv/bin/python. Empty: the built-in fetcher is used.
SCRAPLING_PYTHON=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
